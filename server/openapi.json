{
  "openapi": "3.0.3",
  "info": {
    "title": "Chatterbox API",
    "description": "Backend API for the Chatterbox chat application.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    },
    {
      "url": "https://chatterbox-api-799963617514.us-west1.run.app/api",
      "description": "Live test server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Root Check",
        "description": "Simple check to see if the API is running.",
        "responses": {
          "200": {
            "description": "API is running message",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Chatterbox API is running 🚀"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Checks the health of the service and the database connection.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "db_check": {
                      "type": "integer",
                      "format": "int64",
                      "example": 1
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Login",
        "description": "Logs in a user and returns a JWT token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful, returns JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid JSON or missing user_id"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/sync": {
      "post": {
        "summary": "Sync Data",
        "description": "Syncs rooms, messages, and users. Accepts new local data (rooms, messages) and returns updates from server.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sync successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing token"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/me": {
      "post": {
        "summary": "Update Profile",
        "description": "Updates the user's profile information.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          },
          "400": {
            "description": "Bad Request - Invalid JSON"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/rooms/{roomID}/members": {
      "get": {
        "summary": "Get Room Members",
        "description": "Retrieves the list of members in a specific room.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "roomID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the room"
          }
        ],
        "responses": {
          "200": {
            "description": "List of room members",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoomMember"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "SyncRequest": {
        "type": "object",
        "properties": {
          "last_synced_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp of the last sync. Null for first load."
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomReq"
            },
            "description": "List of locally created rooms to sync to server"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MsgReq"
            },
            "description": "List of locally created messages to sync to server"
          }
        }
      },
      "RoomReq": {
        "type": "object",
        "required": [
          "room_id",
          "name"
        ],
        "properties": {
          "room_id": {
            "type": "string",
            "format": "uuid",
            "description": "Client generated UUID for the room"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "MsgReq": {
        "type": "object",
        "required": [
          "room_id",
          "message_id"
        ],
        "properties": {
          "room_id": {
            "type": "string",
            "description": "ID of the room"
          },
          "message_id": {
            "type": "integer",
            "format": "int64",
            "description": "Client generated message ID"
          },
          "content": {
             "description": "Any JSON content (text or encrypted blob)",
             "nullable": true
          }
        }
      },
      "SyncResponse": {
        "type": "object",
        "properties": {
          "sync_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomResult"
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MsgResult"
            }
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResult"
            }
          }
        }
      },
      "RoomResult": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "last_read_message_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the last message read by the user in this room."
          }
        }
      },
      "MsgResult": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "string"
          },
          "message_id": {
            "type": "integer",
            "format": "int64"
          },
          "sender_id": {
            "type": "string"
          },
          "content": {
            "description": "The message content (JSON)",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserResult": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          }
        }
      },
      "ProfileReq": {
        "type": "object",
        "required": [
          "display_name",
          "public_key"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          }
        }
      },
      "RoomMember": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "X-User-ID": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-ID",
        "description": "Custom header to identify the user."
      }
    }
  }
}
